# --- Gradle / JVM ---
.gradle/
**/build/
!src/**/build/
*.class

# --- Node / qnop-ui ---
node_modules/
qnop-ui/dist/
qnop-ui/.vite/

# --- Local env & secrets ---
.env
.env.local
*.local

# --- IDE / OS ---
.idea/
*.iml
.vscode/
