{
  "name": "qnop-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "generate:api": "openapi-generator-cli generate",
    "dev": "pnpm generate:api && vite",
    "build": "pnpm generate:api && tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm generate:api && tsc -b --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:update": "scripts/e2e-docker.sh --update-snapshots=all",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@emoji-mart/data": "1.2.1",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/outfit": "5.3.0",
    "@mui/material": "9.3.1",
    "@mui/x-date-pickers": "9.11.0",
    "@tanstack/react-query": "5.104.2",
    "@uiw/react-codemirror": "4.25.12",
    "axios": "1.20.0",
    "date-fns": "4.4.0",
    "emoji-mart": "5.6.0",
    "i18next": "26.4.4",
    "lucide-react": "1.56.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-easy-crop": "6.2.4",
    "react-i18next": "17.0.16",
    "react-image-crop": "11.1.2",
    "react-markdown": "10.1.0",
    "react-router": "8.4.0",
    "rehype-highlight": "7.0.2",
    "rehype-sanitize": "6.0.0",
    "remark": "15.0.1",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "strip-markdown": "6.0.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@openapitools/openapi-generator-cli": "2.40.1",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.13.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "4.1.11",
    "vitest-axe": "0.1.0"
  }
}
